<%- include('../partials/admin/head', { title: t('audit_log'), active: 'audit' }) %>
<% const qp = (extra) => {
     const q = new URLSearchParams();
     ['employee','action','entity','from','to'].forEach(function (k) { if (filters[k]) q.set(k, filters[k]); });
     Object.keys(extra || {}).forEach(function (k) { q.set(k, extra[k]); });
     return q.toString();
   }; %>

<div class="alert alert-info"><%- include('../partials/icon', { name: 'shield' }) %><span><%= t('audit_note') %></span></div>

<section class="panel">
  <form class="toolbar" method="get" action="/admin/audit">
    <div class="field"><label for="employee"><%= t('actor') %></label>
      <select id="employee" name="employee"><option value=""><%= t('all') %></option>
        <% employees.forEach(function (e) { %><option value="<%= e.id %>" <%= String(filters.employee) === String(e.id) ? 'selected' : '' %>><%= e.full_name %></option><% }) %>
      </select>
    </div>
    <div class="field"><label for="action"><%= t('action') %></label>
      <select id="action" name="action"><option value=""><%= t('all') %></option>
        <% actions.forEach(function (a) { %><option value="<%= a.action %>" <%= filters.action === a.action ? 'selected' : '' %>><%= a.action %></option><% }) %>
      </select>
    </div>
    <div class="field"><label for="entity"><%= t('entity') %></label>
      <select id="entity" name="entity"><option value=""><%= t('all') %></option>
        <% entities.forEach(function (e) { %><option value="<%= e.entity_type %>" <%= filters.entity === e.entity_type ? 'selected' : '' %>><%= e.entity_type %></option><% }) %>
      </select>
    </div>
    <div class="field"><label for="from"><%= t('from_date') %></label><input id="from" name="from" type="date" value="<%= filters.from || '' %>"></div>
    <div class="field"><label for="to"><%= t('to_date') %></label><input id="to" name="to" type="date" value="<%= filters.to || '' %>"></div>
    <button class="btn btn-primary" type="submit"><%= t('filter') %></button>
    <a class="btn btn-ghost" href="/admin/audit"><%= t('clear_filters') %></a>
  </form>

  <div class="table-wrap">
    <table class="table">
      <thead><tr><th><%= t('date') %></th><th><%= t('actor') %></th><th><%= t('action') %></th><th><%= t('entity') %></th><th><%= t('ip_address') %></th><th><%= t('details') %></th></tr></thead>
      <tbody>
        <% if (!logs.length) { %>
          <tr><td colspan="6"><div class="empty"><%= t('no_results') %></div></td></tr>
        <% } %>
        <% logs.forEach(function (l) { %>
          <tr>
            <td class="nowrap"><%= formatDateTime(l.created_at) %></td>
            <td><%= l.full_name || l.actor_name %></td>
            <td><span class="badge badge-info"><%= l.action %></span></td>
            <td><%= l.entity_type %><%= l.entity_id ? ' #' + l.entity_id : '' %></td>
            <td dir="ltr"><%= l.ip || '—' %></td>
            <td>
              <% if (l.old_values || l.new_values) { %>
                <details class="disclosure">
                  <summary><%= t('view') %></summary>
                  <% if (l.old_values) { %><div class="cell-sub"><%= t('old_values') %>: <code dir="ltr" style="word-break:break-all"><%= JSON.stringify(l.old_values) %></code></div><% } %>
                  <% if (l.new_values) { %><div class="cell-sub"><%= t('new_values') %>: <code dir="ltr" style="word-break:break-all"><%= JSON.stringify(l.new_values) %></code></div><% } %>
                </details>
              <% } else { %>—<% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <div class="pagination">
    <span class="info"><%= t('page') %> <%= pager.page %> <%= t('of') %> <%= pager.pages %> · <%= pager.total %> <%= t('results') %></span>
    <a class="page-link <%= pager.page <= 1 ? 'disabled' : '' %>" href="/admin/audit?<%= qp({ page: pager.page - 1 }) %>"><%= t('prev') %></a>
    <a class="page-link <%= pager.page >= pager.pages ? 'disabled' : '' %>" href="/admin/audit?<%= qp({ page: pager.page + 1 }) %>"><%= t('next') %></a>
  </div>
</section>

<%- include('../partials/admin/foot') %>
