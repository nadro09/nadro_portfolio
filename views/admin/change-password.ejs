<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= dir %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title><%= title %> — AUDIOLEF</title>
  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/assets/admin.css">
</head>
<body class="auth-body">
  <div class="auth-card">
    <div class="auth-brand">
      <span class="mark"><%- include('../partials/icon', { name: 'ear' }) %></span>
      <span><strong>AUDIO LEF</strong><small><%= t('admin_panel') %></small></span>
    </div>

    <h1><%= t('change_password') %></h1>
    <p class="sub"><%= t('must_change_notice') %></p>

    <% if (flash) { %>
      <div class="alert alert-<%= flash.type === 'error' ? 'error' : 'success' %>"><span><%= flash.message %></span></div>
    <% } %>
    <% if (errors && errors.length) { %>
      <div class="alert alert-error">
        <%- include('../partials/icon', { name: 'alert' }) %>
        <div>
          <% errors.forEach(function (e) { %><div><%= e.message %></div><% }) %>
        </div>
      </div>
    <% } %>

    <form method="post" action="/admin/change-password">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field" style="margin-bottom:12px">
        <label for="current_password"><%= t('current_password') %></label>
        <input id="current_password" name="current_password" type="password" autocomplete="current-password" required autofocus>
      </div>
      <div class="field" style="margin-bottom:12px">
        <label for="new_password"><%= t('new_password') %></label>
        <input id="new_password" name="new_password" type="password" autocomplete="new-password" required>
        <span class="hint"><%= t('password_policy', { n: settings.password_min_length || 10 }) %></span>
      </div>
      <div class="field" style="margin-bottom:18px">
        <label for="confirm_password"><%= t('confirm_password') %></label>
        <input id="confirm_password" name="confirm_password" type="password" autocomplete="new-password" required>
      </div>
      <button class="btn btn-primary" type="submit"><%- include('../partials/icon', { name: 'key' }) %><%= t('save') %></button>
    </form>

    <div class="auth-links">
      <a href="/admin/profile"><%= t('menu_profile') %></a>
      <form method="post" action="/admin/logout" style="margin:0">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" style="background:none;border:0;color:var(--blue-700);font:inherit;font-weight:600;cursor:pointer"><%= t('logout') %></button>
      </form>
    </div>
  </div>
</body>
</html>
