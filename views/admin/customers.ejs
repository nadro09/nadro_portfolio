<%- include('../partials/admin/head', { title: t('menu_customers'), active: 'customers' }) %>
<% const qp = (extra) => {
     const q = new URLSearchParams();
     if (filters.q) q.set('q', filters.q);
     if (filters.wilaya) q.set('wilaya', filters.wilaya);
     Object.keys(extra || {}).forEach(function (k) { q.set(k, extra[k]); });
     return q.toString();
   }; %>

<% if (can('customers.edit')) { %>
  <details class="panel">
    <summary style="padding:14px 18px;cursor:pointer;font-weight:700;color:var(--blue-800)"><%= t('create') %> — <%= t('customer_file') %></summary>
    <form method="post" action="/admin/customers" class="panel-body">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="form-grid">
        <div class="field"><label for="new_name"><%= t('field_full_name') %></label><input id="new_name" name="full_name" required></div>
        <div class="field"><label for="new_phone"><%= t('field_phone') %></label><input id="new_phone" name="phone" required dir="ltr" placeholder="+213"></div>
        <div class="field"><label for="new_email"><%= t('field_email') %></label><input id="new_email" name="email" type="email" dir="ltr"></div>
        <div class="field"><label for="new_wilaya"><%= t('wilaya') %></label>
          <select id="new_wilaya" name="wilaya_id"><option value=""><%= t('select_placeholder') %></option>
            <% wilayas.forEach(function (w) { %><option value="<%= w.id %>"><%= w.id %> — <%= lang === 'fr' ? w.name_fr : w.name_ar %></option><% }) %>
          </select>
        </div>
        <div class="field"><label for="new_city"><%= t('field_city') %></label><input id="new_city" name="city"></div>
        <div class="field"><label for="new_notes"><%= t('internal_notes') %></label><input id="new_notes" name="notes"></div>
      </div>
      <div class="form-actions"><button class="btn btn-primary" type="submit"><%- include('../partials/icon', { name: 'plus' }) %><%= t('create') %></button></div>
    </form>
  </details>
<% } %>

<section class="panel">
  <form class="toolbar" method="get" action="/admin/customers">
    <div class="field grow"><label for="q"><%= t('search') %></label><input id="q" name="q" value="<%= filters.q || '' %>" placeholder="<%= t('search_placeholder') %>"></div>
    <div class="field"><label for="wilaya"><%= t('wilaya') %></label>
      <select id="wilaya" name="wilaya"><option value=""><%= t('all') %></option>
        <% wilayas.forEach(function (w) { %><option value="<%= w.id %>" <%= String(filters.wilaya) === String(w.id) ? 'selected' : '' %>><%= lang === 'fr' ? w.name_fr : w.name_ar %></option><% }) %>
      </select>
    </div>
    <button class="btn btn-primary" type="submit"><%= t('filter') %></button>
    <a class="btn btn-ghost" href="/admin/customers"><%= t('clear_filters') %></a>
  </form>

  <div class="table-wrap">
    <table class="table">
      <thead><tr><th><%= t('field_full_name') %></th><th><%= t('field_phone') %></th><th><%= t('wilaya') %></th><th><%= t('bookings_count') %></th><th><%= t('last_booking') %></th><th><%= t('created_at') %></th><th></th></tr></thead>
      <tbody>
        <% if (!customers.length) { %>
          <tr><td colspan="7"><div class="empty"><div class="ico"><%- include('../partials/icon', { name: 'users' }) %></div><%= t('no_results') %></div></td></tr>
        <% } %>
        <% customers.forEach(function (cu) { %>
          <tr>
            <td><div class="cell-main"><%= cu.full_name %></div><% if (cu.is_demo) { %><span class="badge badge-demo"><%= t('demo_badge') %></span><% } %><div class="cell-sub"><%= cu.email || '' %></div></td>
            <td dir="ltr"><%= cu.phone %></td>
            <td><%= lang === 'fr' ? (cu.wilaya_fr || '—') : (cu.wilaya_ar || '—') %><div class="cell-sub"><%= cu.city || '' %></div></td>
            <td><span class="badge badge-info"><%= cu.bookings_count %></span></td>
            <td class="nowrap"><%= cu.last_booking ? formatDateTime(cu.last_booking) : '—' %></td>
            <td class="nowrap"><%= formatDate(cu.created_at) %></td>
            <td><a class="btn btn-ghost btn-sm" href="/admin/customers/<%= cu.id %>"><%= t('view') %></a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <div class="pagination">
    <span class="info"><%= t('page') %> <%= pager.page %> <%= t('of') %> <%= pager.pages %> · <%= pager.total %> <%= t('results') %></span>
    <a class="page-link <%= pager.page <= 1 ? 'disabled' : '' %>" href="/admin/customers?<%= qp({ page: pager.page - 1 }) %>"><%= t('prev') %></a>
    <a class="page-link <%= pager.page >= pager.pages ? 'disabled' : '' %>" href="/admin/customers?<%= qp({ page: pager.page + 1 }) %>"><%= t('next') %></a>
  </div>
</section>

<%- include('../partials/admin/foot') %>
