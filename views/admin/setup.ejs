<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= dir %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title><%= title %> — AUDIOLEF</title>
  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/assets/admin.css">
</head>
<body class="auth-body">
  <div class="auth-card">
    <div class="auth-brand">
      <span class="mark has-logo"><img src="/assets/audiolef-logo.png" alt="AUDIOLEF"></span>
      <span><strong>AUDIO LEF</strong><small><%= t('admin_panel') %></small></span>
    </div>

    <h1><%= t('setup_title') %></h1>
    <p class="sub"><%= t('setup_subtitle') %></p>

    <% if (flash) { %>
      <div class="alert alert-<%= flash.type === 'error' ? 'error' : 'success' %>"><span><%= flash.message %></span></div>
    <% } %>
    <% if (errors && errors.length) { %>
      <div class="alert alert-error">
        <%- include('../partials/icon', { name: 'alert' }) %>
        <div>
          <% errors.forEach(function (e) { %><div><%= e.message %></div><% }) %>
        </div>
      </div>
    <% } %>

    <form method="post" action="/admin/setup">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field" style="margin-bottom:12px">
        <label for="full_name"><%= t('field_full_name') %></label>
        <input id="full_name" name="full_name" value="<%= values.full_name || '' %>" autocomplete="name" required autofocus>
      </div>
      <div class="field" style="margin-bottom:12px">
        <label for="email"><%= t('login_email') %></label>
        <input id="email" name="email" type="email" value="<%= values.email || '' %>" autocomplete="email" dir="ltr" required>
      </div>
      <div class="field" style="margin-bottom:12px">
        <label for="username"><%= t('username') %></label>
        <input id="username" name="username" value="<%= values.username || '' %>" autocomplete="username" dir="ltr" required>
      </div>
      <div class="field" style="margin-bottom:12px">
        <label for="password"><%= t('password') %></label>
        <input id="password" name="password" type="password" autocomplete="new-password" required>
        <span class="hint"><%= t('password_policy', { n: minLength }) %></span>
      </div>
      <div class="field" style="margin-bottom:18px">
        <label for="confirm_password"><%= t('confirm_password') %></label>
        <input id="confirm_password" name="confirm_password" type="password" autocomplete="new-password" required>
      </div>
      <button class="btn btn-primary" type="submit"><%- include('../partials/icon', { name: 'key' }) %><%= t('setup_submit') %></button>
    </form>

    <div class="auth-links">
      <a href="/admin/login"><%= t('login') %></a>
      <a href="/?lang=<%= lang %>"><%= t('menu_view_site') %></a>
    </div>
  </div>
</body>
</html>
