<%- include('../partials/public/head', { title: title || t('forbidden_title'), nav: 'home' }) %>
<section class="section" style="padding-top:64px">
  <div class="container" style="text-align:center;max-width:640px">
    <div style="width:82px;height:82px;border-radius:24px;background:var(--blue-50);color:var(--blue-700);display:grid;place-items:center;margin:0 auto 18px">
      <div style="width:36px;height:36px"><%- include('../partials/icon', { name: 'lock' }) %></div>
    </div>
    <h1 style="color:var(--blue-950)"><%= t('forbidden_title') %></h1>
    <p style="color:var(--muted)"><%= t('forbidden_text') %></p>
    <div class="form-actions" style="justify-content:center">
      <a class="btn btn-primary" href="/?lang=<%= lang %>"><%= t('back_home') %></a>
      <a class="btn btn-ghost" href="/admin"><%= t('admin_panel') %></a>
    </div>
  </div>
</section>
<%- include('../partials/public/footer') %>
