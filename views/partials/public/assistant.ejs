<%# Customer-facing assistant: available on every public page. %>
<div class="assistant" id="assistant"
     data-csrf="<%= csrfToken %>"
     data-greeting="<%= t('assistant_greeting') %>"
     data-error="<%= t('assistant_error') %>"
     data-unavailable="<%= t('assistant_unavailable') %>"
     data-thinking="<%= t('assistant_thinking') %>">
  <button type="button" class="assistant-launcher" id="assistantLauncher"
          aria-expanded="false" aria-controls="assistantPanel" aria-label="<%= t('assistant_title') %>">
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M21 11.5a8.4 8.4 0 0 1-9 8.5 9.3 9.3 0 0 1-3-.5L4 21l1.6-4.6A8.2 8.2 0 0 1 3 11.5 8.4 8.4 0 0 1 12 3a8.4 8.4 0 0 1 9 8.5Z" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round"/>
      <circle cx="8.4" cy="11.6" r="1.2" fill="currentColor"/>
      <circle cx="12" cy="11.6" r="1.2" fill="currentColor"/>
      <circle cx="15.6" cy="11.6" r="1.2" fill="currentColor"/>
    </svg>
    <span class="assistant-launcher-text"><%= t('assistant_title') %></span>
  </button>

  <section class="assistant-panel" id="assistantPanel" role="dialog" aria-modal="false"
           aria-labelledby="assistantTitle" hidden>
    <header class="assistant-head">
      <div class="assistant-id">
        <span class="assistant-brand"><img src="/assets/audiolef-logo.png" alt="AUDIOLEF"></span>
        <div>
          <h2 id="assistantTitle"><%= t('assistant_title') %></h2>
          <p><%= t('assistant_subtitle') %></p>
        </div>
      </div>
      <button type="button" class="assistant-close" id="assistantClose" aria-label="<%= t('close') %>">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      </button>
    </header>

    <div class="assistant-log" id="assistantLog" role="log" aria-live="polite" aria-relevant="additions"></div>

    <form class="assistant-form" id="assistantForm">
      <label class="assistant-sr" for="assistantInput"><%= t('assistant_placeholder') %></label>
      <textarea id="assistantInput" name="message" rows="1" maxlength="1000" required
                placeholder="<%= t('assistant_placeholder') %>"></textarea>
      <button type="submit" class="assistant-send" id="assistantSend" aria-label="<%= t('assistant_send') %>">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 12l16-8-6 16-2.6-6.2L4 12Z" fill="currentColor"/></svg>
      </button>
    </form>
    <p class="assistant-note"><%= t('assistant_private') %></p>
  </section>
</div>
<link rel="stylesheet" href="/assets/assistant.css">
<script src="/assets/assistant.js" defer></script>
